#!/usr/bin/env sh
# mcp-probe-kit-cli-version: 4.0.1
set -eu

WRAPPER_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
CACHE_ROOT="${MCP_PROBE_NPX_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/mcp-probe-kit/npm-cache}"
if [ -n "${MCP_PROBE_LOCAL_ENTRY:-}" ]; then
  exec node "$MCP_PROBE_LOCAL_ENTRY" "$@"
fi
exec npx --yes --cache "$CACHE_ROOT" "mcp-probe-kit@4.0.1" "$@"
