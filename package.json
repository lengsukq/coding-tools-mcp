  "description": "Coding Tools MCP desktop client",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/lengsukq/coding-tools-mcp.git"
  },
  "homepage": "https://github.com/lengsukq/coding-tools-mcp",
  "bugs": {
    "url": "https://github.com/lengsukq/coding-tools-mcp/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "start": "tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "test:workspace": "cargo test --manifest-path src-tauri/Cargo.toml --test workspace_e2e --locked",
