{
  "name": "coding-tools-mcp-desktop",
  "version": "0.3.10",
  "description": "Coding Tools MCP desktop client",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/lengsukq/coding-tools-mcp.git"
  },
  "homepage": "https://github.com/lengsukq/coding-tools-mcp",
  "bugs": {
    "url": "https://github.com/lengsukq/coding-tools-mcp/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:signed": "node scripts/build-macos-signed.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "lint": "biome lint --error-on-warnings",
    "check:dead": "knip",
    "catalog:sync": "node scripts/sync-ui-catalog.mjs",
    "catalog:check": "node scripts/sync-ui-catalog.mjs --check",
    "check:fe": "pnpm run version:check && pnpm run catalog:check && pnpm run check && pnpm run lint && pnpm run check:dead && pnpm run test:ui && pnpm run build",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo clippy --manifest-path src-tauri/Cargo.toml --no-default-features --lib --bin coding-tools-mcp --tests --locked -- -D warnings",
    "check:rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib --bin coding-tools-mcp --tests --locked",
    "verify": "pnpm run check:fe && pnpm run check:rust:fmt && pnpm run check:rust:clippy && pnpm run check:rust:test",
    "test:workspace": "cargo test --manifest-path src-tauri/Cargo.toml --test workspace_e2e --locked",
    "test:release": "pnpm run verify",
    "version:set": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "tauri": "tauri",
    "test:ui": "node --test tests/*.test.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@lucide/vue": "^1.46.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "knip": "^6.48.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.2.0"
  }
}
